{
  "name": "ablunitrunner",
  "displayName": "ABLUnit Runner",
  "description": "A VSCode extension designed for running ABLUnit tests without any time limits",
  "version": "1.0.9",
  "publisher": "wayfare",
  "icon": "resources/logo.png",
  "homepage": "https://github.com/wayfarero/ablunitrunner/blob/main/README.md",
  "repository": "https://github.com/wayfarero/ablunitrunner",
  "bugs": {
		"url": "https://github.com/wayfarero/ablunitrunner/issues"
	},
  "license": "MIT",
	"licenses": [
		{
			"type": "MIT",
			"url": "https://github.com/wayfarero/ablunitrunner/blob/main/LICENSE"
		}
	],
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
		"4gl",
		"abl",
		"ablunit",
		"oeunit",
		"openedge",
		"pdsoe",
		"progress"
	],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ABLUnitRunner.RunABLUnitOnFile",
        "title": "Run ABLUnit"
      },
      {
        "command": "ABLUnitRunner.RunABLUnitOnTestItem",
        "title": "Rerun Test"
      },
      {
        "command": "ABLUnitRunner.RunABLUnitOnTestSuite",
        "title": "Rerun Suite"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ABLUnitRunner.RunABLUnitOnFile",
          "when": "editorTextFocus && (resourceExtname == .cls || resourceExtname == .p)",
          "group": "navigation"
        }
      ],
       "explorer/context": [
        {
          "command": "ABLUnitRunner.RunABLUnitOnFile",
          "when": "resourceExtname == .cls || resourceExtname == .p",
          "group": "navigation"
        }
      ],
      "testing/item/context": [
        {
          "command": "ABLUnitRunner.RunABLUnitOnTestItem",
          "when": "testId =~ /:/",
          "group": "navigation"
        },
        {
          "command": "ABLUnitRunner.RunABLUnitOnTestSuite",
          "group": "navigation"
        }
      ],
      "testing/item/result": [
        {
          "command": "ABLUnitRunner.RunABLUnitOnTestItem",
          "group": "navigation"
        },
        {
          "command": "ABLUnitRunner.RunABLUnitOnTestSuite",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1"
  },
  "dependencies": {
    "xmldom": "^0.6.0"
  }
}
